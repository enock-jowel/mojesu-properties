# Site
NEXT_PUBLIC_SITE_URL=https://mojesuproperties.com
SITE_URL=https://mojesuproperties.com

# Supabase (CMS + Auth + Storage) — required for /admin and Phase 2+
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Manager notifications
NOTIFY_EMAIL_TO=hello@mojesuproperties.com
NOTIFY_EMAIL_FROM="Mojesu <hello@mojesuproperties.com>"

# WhatsApp — client-side wa.me only (no Twilio/Meta API).
# Digits with country code, no + or spaces. Used by BookingConfirmation CTA.
NEXT_PUBLIC_WHATSAPP_NUMBER=256780827159
# Alias used by some client submit helpers
# NEXT_PUBLIC_NOTIFY_WHATSAPP_NUMBER=256780827159

# Email via Resend free tier (https://resend.com) — required for notify mail
RESEND_API_KEY=

# Optional: comma-separated extra hosts allowed to POST lead APIs
# ALLOWED_LEAD_ORIGINS=staging.example.com

# Optional URL shortener for WhatsApp message links
BITLY_ACCESS_TOKEN=

# Google Places — live reviews on the home Reviews section (keeps existing UI)
# 1. Enable "Places API (New)" in Google Cloud Console
# 2. Create an API key (server-only; restrict by API if possible)
# 3. Paste your Google Business / Maps link, then run:
#      pnpm exec tsx scripts/resolve-google-place-id.ts "<your-link>"
# 4. Set GOOGLE_PLACE_ID from the script output
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_BUSINESS_MAPS_URL=

# Image budget check (scripts/check-image-budget.ts)
# LISTING_IMAGE_BUDGET=40960

# OpenNext / Cloudflare build flag (scripts set this; do not set for Vercel)
# OPEN_NEXT_BUILD=1

# Optional override if APIs are hosted elsewhere
# NEXT_PUBLIC_BOOKINGS_API_URL=https://mojesuproperties.com/api/viewing-bookings
# NEXT_PUBLIC_SUBMISSIONS_API_URL=https://mojesuproperties.com/api/property-submissions
# NEXT_PUBLIC_CONTACT_API_URL=https://mojesuproperties.com/api/contact-enquiries
# NEXT_PUBLIC_SERVICE_ENQUIRY_API_URL=https://mojesuproperties.com/api/service-enquiries
# NEXT_PUBLIC_LISTINGS_API_URL=https://mojesuproperties.com/api/listings
